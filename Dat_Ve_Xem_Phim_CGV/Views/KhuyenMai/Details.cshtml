@model Dat_Ve_Xem_Phim_CGV.Models.KHUYENMAI
@{
    ViewBag.Title = Model.TENKM;
    Layout = "~/Views/Shared/_Layout1.cshtml";
    var listKhac = ViewBag.KhuyenMaiKhac as List<Dat_Ve_Xem_Phim_CGV.Models.KHUYENMAI>;
}

<style>
    .detail-section {
        padding: 40px 0;
        background-color: #fff;
        border-bottom: 1px solid #ddd;
    }

    /* Cột hình ảnh */
    .detail-img {
        width: 100%;
        border: 2px solid #222;
        padding: 5px;
        border-radius: 2px;
    }

    /* Cột nội dung */
    .detail-title {
        font-size: 24px;
        font-weight: bold;
        color: #e71a0f; /* Màu đỏ CGV */
        text-transform: uppercase;
        margin-bottom: 15px;
        border-bottom: 2px solid #ddd;
        padding-bottom: 10px;
    }

    .detail-info p {
        margin-bottom: 10px;
        line-height: 1.6;
        color: #333;
    }

    .detail-label {
        font-weight: bold;
        color: #000;
    }

    /* Phần khuyến mãi khác */
    .related-section {
        padding: 40px 0;
        background-color: #fdfcf0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 900;
        font-size: 28px;
        text-transform: uppercase;
        color: #222;
        border-bottom: 3px double #444;
        display: inline-block;
    }

    /* Card nhỏ bên dưới */
    .related-card {
        margin-bottom: 20px;
        transition: 0.3s;
    }

        .related-card:hover {
            opacity: 0.8;
            transform: translateY(-3px);
        }

    .related-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border: 1px solid #ccc;
    }

    .related-title {
        font-weight: bold;
        font-size: 14px;
        color: #333;
        margin-top: 10px;
        text-transform: uppercase;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
</style>

<div class="detail-section">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <img src="@Url.Content("~/Content/Img/khuyenmai.jpg")" class="detail-img" alt="@Model.TENKM" />
            </div>

            <div class="col-md-8">
                <div class="detail-title">@Model.TENKM</div>

                <div class="detail-info">
                    <p>
                        <span class="detail-label">Thời gian khuyến mãi:</span><br />
                        @(Model.NGAYBD.HasValue ? Model.NGAYBD.Value.ToString("dd/MM/yyyy") : "")
                        -
                        @(Model.NGAYKT.HasValue ? Model.NGAYKT.Value.ToString("dd/MM/yyyy") : "")
                    </p>

                    <p>
                        <span class="detail-label">Loại ưu đãi:</span> @Model.LOAIKM
                    </p>

                    <hr />

                    <p><span class="detail-label">Chi tiết & Điều kiện:</span></p>
                    <div style="text-align: justify;">
                        @if (!string.IsNullOrEmpty(Model.DIEUKIEN))
                        {
                            @Html.Raw(Model.DIEUKIEN.Replace(".", ".<br/>- ").Replace(",", ", "))
                        }
                        else
                        {
                            <span>Đang cập nhật chi tiết...</span>
                        }
                    </div>

                    <div style="margin-top: 20px;">
                        <a href="@Url.Action("Index", "KhuyenMai")" class="btn btn-dark">
                            <i class="fa fa-arrow-left"></i> Quay lại danh sách
                        </a>
                        <a href="@Url.Action("Index", "MuaVe")" class="btn btn-danger" style="margin-left: 10px;">
                            Đặt Vé Ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="related-section">
    <div class="container">
        <div style="text-align:center;">
            <h3 class="section-header">CÁC ƯU ĐÃI KHÁC</h3>
        </div>

        <div class="row">
            @if (listKhac != null && listKhac.Count > 0)
            {
                foreach (var item in listKhac)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="related-card">
                            <a href="@Url.Action("Details", "KhuyenMai", new { id = item.MAKM })" style="text-decoration:none;">
                                <img src="@Url.Content("~/Content/Img/khuyenmai.jpg")" class="related-img" />
                                <div class="related-title">@item.TENKM</div>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Không có khuyến mãi khác.</p>
            }
        </div>
    </div>
</div>