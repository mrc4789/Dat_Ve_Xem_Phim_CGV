@model IEnumerable<Dat_Ve_Xem_Phim_CGV.Models.DICHVU>

<style>
    .combo-wrapper {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
    }

    .combo-header-title {
        font-weight: 900;
        color: #333;
        text-transform: uppercase;
        border-left: 5px solid #e71a0f;
        padding-left: 10px;
        margin-bottom: 15px;
    }

    .combo-row {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px dashed #ddd;
    }

    .combo-thumb {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border: 1px solid #f0f0f0;
        border-radius: 5px;
        margin-right: 15px;
    }

    .combo-info {
        flex: 1;
    }

    .combo-name {
        font-weight: bold;
        font-size: 14px;
        color: #333;
    }

    .combo-price {
        font-weight: bold;
        color: #e71a0f;
        font-size: 14px;
        margin-top: 3px;
    }

    .qty-control {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 4px;
        overflow: hidden;
    }

    .btn-qty {
        width: 28px;
        height: 28px;
        background: #f8f9fa;
        border: none;
        font-weight: bold;
        cursor: pointer;
        color: #333;
    }

    .input-qty {
        width: 45px;
        height: 28px;
        text-align: center;
        border: none;
        border-left: 1px solid #ccc;
        border-right: 1px solid #ccc;
        font-weight: bold;
        font-size: 14px;
        outline: none;
        background: #fff;
        -moz-appearance: textfield;
    }

        .input-qty::-webkit-outer-spin-button, .input-qty::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
</style>

<div class="combo-wrapper">
    <div class="combo-header-title">Chọn Combo & Bắp Nước</div>

    @foreach (var item in Model)
    {
        string imgFileName = "combo.jpg";
        string ten = (item.TENDV ?? "").ToLower();
        if (ten.Contains("bắp")) { imgFileName = "bap.jpg"; }
        else if (ten.Contains("nước") || ten.Contains("coca") || ten.Contains("pepsi")) { imgFileName = "nuoc.jpg"; }

        <div class="combo-row">
            <img src="@Url.Content("~/Content/Img/" + imgFileName)" class="combo-thumb" />
            <div class="combo-info">
                <div class="combo-name">@item.TENDV</div>
                <div class="combo-price">@string.Format("{0:N0}", item.GIADV) đ</div>
                <input type="hidden" class="hidden-price" data-id="@item.MADV" value="@item.GIADV" />
            </div>
            <div class="qty-control">
                <button type="button" class="btn-qty" onclick="updateQty('@item.MADV', -1)">-</button>

                <input type="number" id="qty_@item.MADV" value="0" min="0" class="input-qty combo-input"
                       onchange="validateInput(this)" />

                <button type="button" class="btn-qty" onclick="updateQty('@item.MADV', 1)">+</button>
            </div>
        </div>
    }
</div>

<script>
    function updateQty(id, delta) {
        var input = $('#qty_' + id);
        var val = parseInt(input.val()) || 0;
        var newVal = val + delta;
        if (newVal >= 0) {
            input.val(newVal);
            calculateTotal(); // Gọi hàm tính tiền ở trang cha
        }
    }

    function validateInput(el) {
        var val = parseInt($(el).val());
        if (isNaN(val) || val < 0) {
            $(el).val(0); // Reset về 0 nếu nhập sai
        }
        calculateTotal(); // Gọi hàm tính tiền
    }
</script>