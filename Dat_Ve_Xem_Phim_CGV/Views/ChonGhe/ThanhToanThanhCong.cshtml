@{
    ViewBag.Title = "Thanh toán thành công";
    Layout = "~/Views/Shared/_Layout1.cshtml";

    // Lấy dữ liệu từ TempData
    string tenPhim = TempData["TenPhim"]?.ToString() ?? "Không xác định";
    string doTuoi = TempData["DoTuoi"]?.ToString() ?? "P";
    string thoiLuong = TempData["ThoiLuongHienThi"]?.ToString() ?? "";
    string dinhDang = TempData["DinhDang"]?.ToString() ?? "";
    DateTime? ngayChieu = TempData["NgayChieu"] as DateTime?;
    TimeSpan? gioChieu = TempData["GioChieu"] as TimeSpan?;
    string maRap = TempData["MaRapLabel"]?.ToString() ?? "";
    string tenRap = TempData["TenRap"]?.ToString() ?? "";
    string diaChiRap = TempData["DiaChiRap"]?.ToString() ?? "";
    string danhSachGhe = TempData["DanhSachGhe"]?.ToString() ?? "---";
    int soLuongCombo = Convert.ToInt32(TempData["SoLuongCombo"] ?? 0);
    string maVe = TempData["MaVe"]?.ToString() ?? "---";
    decimal tongTien = Convert.ToDecimal(TempData["TongTien"] ?? 0);
    string maGiaoDich = TempData["MaGiaoDich"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thanh toán thành công</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f0f0;
            margin: 0;
            padding: 0;
        }

        .main-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .ticket-container {
            background-color: #1a2238;
            color: #ffffff;
            width: 100%;
            max-width: 380px;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            position: relative;
        }

        .success-text {
            text-align: center;
            color: #00e676;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .movie-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #fff;
            line-height: 1.3;
        }

        .movie-info-row {
            display: flex;
            align-items: center;
            font-size: 13px;
            color: #a0a3a8;
            margin-bottom: 25px;
        }

        .age-badge {
            background-color: #ff9800;
            color: #000;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 11px;
            margin-right: 8px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .info-item {
            display: flex;
            flex-direction: column;
        }

        .label {
            font-size: 11px;
            color: #8da0bc;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .value {
            font-size: 15px;
            font-weight: 600;
            color: #ffffff;
            word-break: break-word;
        }

        .cinema-info {
            margin-top: 10px;
            margin-bottom: 20px;
        }

        .cinema-name {
            font-size: 12px;
            color: #8da0bc;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .cinema-address {
            font-size: 14px;
            line-height: 1.4;
            font-weight: 500;
        }

        .divider {
            border-top: 2px dashed #3a4b6b;
            margin: 25px -24px;
            position: relative;
        }

            .divider::before, .divider::after {
                content: "";
                position: absolute;
                top: -12px;
                width: 24px;
                height: 24px;
                background-color: #f0f0f0;
                border-radius: 50%;
            }

            .divider::before {
                left: -12px;
            }

            .divider::after {
                right: -12px;
            }

        .ticket-code-section {
            text-align: center;
            margin-bottom: 20px;
        }

        .ticket-code-box {
            background-color: #0d1424;
            border: 1px solid #2a3b55;
            border-radius: 8px;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .code-value {
            color: #00e676;
            font-weight: 700;
            font-size: 16px;
            font-family: monospace;
            letter-spacing: 1px;
        }

        .copy-icon {
            color: #00e676;
            cursor: pointer;
            font-size: 18px;
        }

        .footer-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-top: 1px solid #3a4b6b;
            padding-top: 15px;
            margin-top: 10px;
        }

        .price-value {
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
        }

        .trans-id {
            font-size: 13px;
            color: #fff;
            font-family: monospace;
        }
        /* Nút hành động */
        .action-buttons {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .action-btn {
            padding: 14px 20px;
            border-radius: 10px;
            text-align: center;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            display: block;
            transition: all 0.3s ease;
        }

        .primary-btn {
            background-color: #00e676;
            color: #000000;
        }

            .primary-btn:hover {
                background-color: #00c853;
                transform: translateY(-2px);
            }

        .secondary-btn {
            background-color: #0d1424;
            color: #ffffff;
            border: 1px solid #2a3b55;
        }

            .secondary-btn:hover {
                background-color: #1a2238;
                border-color: #00e676;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <div class="ticket-container">
            <!-- Sửa lỗi: thêm tick và căn giữa đúng -->
            <div class="success-text"> Thanh toán thành công</div>

            <div class="movie-title">@tenPhim</div>

            <div class="movie-info-row">
                <span class="age-badge">@doTuoi</span>
                <span>@thoiLuong • @dinhDang</span>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <span class="label">Ngày</span>
                    <span class="value">@(ngayChieu.HasValue ? ngayChieu.Value.ToString("dd/MM/yyyy") : "--")</span>
                </div>
                <div class="info-item">
                    <span class="label">Giờ</span>
                    <span class="value">@(gioChieu.HasValue ? DateTime.Today.Add(gioChieu.Value).ToString("HH:mm") : "--")</span>
                </div>
                <div class="info-item">
                    <span class="label">Rạp</span>
                    <span class="value">@maRap</span>
                </div>
            </div>

            <div class="info-grid" style="grid-template-columns: 2fr 1fr;">
                <div class="info-item">
                    <span class="label">Vị trí ghế</span>
                    <span class="value">@danhSachGhe</span>
                </div>
                <div class="info-item">
                    <span class="label">Combo</span>
                    <span class="value">@soLuongCombo</span>
                </div>
            </div>

            <div class="cinema-info">
                <div class="cinema-name">@tenRap</div>
                <div class="cinema-address">@diaChiRap</div>
            </div>

            <div class="divider"></div>

            <div class="ticket-code-section">
                <span class="label" style="display:block; margin-bottom: 10px;">Mã vé</span>
                <div class="ticket-code-box">
                    <span class="code-value">@maVe</span>
                    <span class="copy-icon">❐</span>
                </div>
            </div>

            <div class="footer-row">
                <div>
                    <span class="label">Tổng tiền thanh toán</span><br />
                    <span class="price-value">@string.Format("{0:0,0}đ", tongTien)</span>
                </div>
                <div style="text-align: right;">
                    <span class="label">Mã giao dịch</span><br />
                    <span class="trans-id">@maGiaoDich</span>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="action-buttons">
                <a href="@Url.Action("Index", "MuaVe")" class="action-btn primary-btn">
                     Đặt vé tiếp
                </a>
                <a href="@Url.Action("LichSuDatVe", "KhachHang")" class="action-btn secondary-btn">
                     Xem lịch sử đặt vé
                </a>
            </div>
        </div>
    </div>
</body>
</html>