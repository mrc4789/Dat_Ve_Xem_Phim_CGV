@model IEnumerable<Dat_Ve_Xem_Phim_CGV.Models.KHUYENMAI>
@{
    ViewBag.Title = "Tin Mới & Ưu Đãi";
    Layout = "~/Views/Shared/_Layout1.cshtml";
}

<style>
    .promo-section {
        padding: 40px 0;
        background-color: #fdfcf0;
    }

    .cgv-title {
        text-align: center;
        margin-bottom: 20px;
        position: relative;
    }

        .cgv-title h2 {
            display: inline-block;
            background: #fdfcf0;
            padding: 0 20px;
            position: relative;
            z-index: 2;
            font-weight: 900;
            font-size: 35px;
            text-transform: uppercase;
            color: #222;
            text-shadow: 3px 3px 0px #ddd;
            border-bottom: 3px double #444;
        }

        .cgv-title::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 2px;
            background: #444;
            z-index: 1;
        }

    /* --- STYLE CHO NÚT ĐIỀU HƯỚNG --- */
    .nav-cgv {
        text-align: center;
        margin-bottom: 40px;
    }

    .btn-cgv-tab {
        display: inline-block;
        padding: 10px 30px;
        margin: 0 5px;
        font-weight: bold;
        text-transform: uppercase;
        text-decoration: none;
        color: white;
        transition: 0.3s;
        clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
        min-width: 150px;
        text-align: center;
    }

        .btn-cgv-tab:hover {
            text-decoration: none;
            color: white;
            opacity: 0.9;
        }

    .btn-active {
        background: #e71a0f;
    }

    .btn-inactive {
        background: #333;
    }

    /* Card */
    .promo-card {
        margin-bottom: 30px;
        transition: 0.3s;
        cursor: pointer;
    }

        .promo-card:hover {
            transform: translateY(-5px);
        }

    .promo-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border: 2px solid #333;
    }

    /* STYLE CHO TÊN KHUYẾN MÃI */
    .promo-name {
        font-weight: bold;
        font-size: 16px;
        color: #333;
        margin-top: 10px;
        margin-bottom: 5px;
        text-transform: uppercase;
        line-height: 1.4;
        min-height: 45px;
        height: auto;
        overflow: visible;
        display: block;
    }

    .promo-date {
        font-weight: bold;
        color: #777;
        font-size: 13px;
    }

        .promo-date i {
            color: #e71a0f;
            margin-right: 5px;
        }
</style>

<div class="promo-section">
    <div class="container">
        <div class="cgv-title">
            <h2>Tin Mới Và Ưu Đãi</h2>
        </div>

        <div class="nav-cgv">
            <a href="@Url.Action("Index", "DichVu")" class="btn-cgv-tab btn-inactive">Dịch Vụ</a>
            <a href="@Url.Action("Index", "KhuyenMai")" class="btn-cgv-tab btn-active">Khuyến Mãi</a>
        </div>

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-6 promo-card">
                    <a href="@Url.Action("Details", "KhuyenMai", new { id = item.MAKM })" style="text-decoration:none;">

                        <img src="@Url.Content("~/Content/Img/khuyenmai.jpg")" class="promo-img" alt="Khuyen Mai" />

                        <div class="promo-name">@item.TENKM</div>

                        <div class="promo-date">
                            <i class="fa fa-calendar-alt"></i>
                            @(item.NGAYBD.HasValue ? item.NGAYBD.Value.ToString("dd/MM/yyyy") : "") -
                            @(item.NGAYKT.HasValue ? item.NGAYKT.Value.ToString("dd/MM/yyyy") : "")
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>